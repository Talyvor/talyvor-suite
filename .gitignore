node_modules/
dist/
*.tsbuildinfo
.DS_Store
.eslintcache
coverage/

# Go build artifact (go build in apps/bff drops the binary in-place)
apps/bff/bff
.vitest-report.json

# Per-worker reach shards, written by test-setup.ts and read by check-audit-reach.mjs. Cleared at
# the start of every vitest run, because a stale shard would let a run that measured nothing be
# answered from a run that did.
apps/web/.reach/
packages/ui/.reach/

# Where check-audit-gate.mjs sends its probe run's shards (REACH_SHARD_DIR). The probe is a real
# vitest run and would otherwise clear the directory above as the LAST act of every `pnpm test`,
# leaving the next reach check to report a hook it broke itself. Removed on every exit path; also
# ignored, because an interrupted run would otherwise make `git status --porcelain` dirty.
apps/web/.reach-probe/
packages/ui/.reach-probe/

# Release artifacts from scripts/build-release.sh. Ignored not just for tidiness: an untracked
# build output would make `git status --porcelain` dirty, and the script's dirty-tree check would
# then stamp every subsequent build "-dirty" because of its own previous output.
bff-*-*

# THE SAME HAZARD AS THE TWO ENTRIES ABOVE, THIRD INSTANCE. The ~40 control harnesses in scripts/ are
# censused by IMPORTING them (a static reader of them has lied three times — see W1.1.10), and an
# import writes scripts/__pycache__/. Untracked, that made build-release.sh — which reads
# `git status --porcelain` — stamp the next workstation build "<sha>-dirty" for a bytecode cache.
# Measured both ways at be91a30 before this line existed: cache present -> be91a30-dirty, removed ->
# be91a30. It fails in the SAFE direction, so the point of ignoring it is that the suffix keeps
# meaning something; a REAL uncommitted edit and an unexpected untracked artifact must both still
# stamp "-dirty", and ~/talyvor-queue/w11-pycachestamp-controls-5e8a.py holds that to P1 and P4.
__pycache__/

# B17.3 harness results (run-<time>.json); the kept report is docs/e2e (B17.4).
e2e/out/

# B57.1 — pocket-shots builds the component story page here, outside dist, so the app never serves it.
apps/web/.pocket-story/
