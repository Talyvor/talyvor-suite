      "id": "inference",
      "title": "Inference",
      "about": "Send a model request through Lens: set your SDK's base URL to Lens's address plus one of these prefixes, and keep using the SDK as before. Lens checks the rules, meters the call and records it in your ledger. POST only, in the provider's own request shape: whatever the SDK appends after the prefix is absorbed.",
      "screen": { "href": "/setup", "label": "Setup prints the exact base URL for each tool" },
      "routes": [
        { "method": "POST", "path": "/v1/proxy/openai/*", "does": "OpenAI-compatible request" },
        { "method": "POST", "path": "/v1/proxy/anthropic/*", "does": "Anthropic Messages request" },
        { "method": "POST", "path": "/v1/proxy/google/*", "does": "Google Gemini request" },
        { "method": "POST", "path": "/v1/proxy/bedrock/*", "does": "AWS Bedrock request" },
        { "method": "POST", "path": "/v1/proxy/mistral/*", "does": "Mistral request" },
        { "method": "POST", "path": "/v1/proxy/groq/*", "does": "Groq request" },
        { "method": "POST", "path": "/v1/proxy/vllm/*", "does": "Request to a vLLM server Lens is configured with" },
        { "method": "POST", "path": "/oai/*", "does": "Same handler as /v1/proxy/openai, shorter prefix" },
        { "method": "POST", "path": "/anthropic/*", "does": "Same handler as /v1/proxy/anthropic, the one Claude Code uses" },
        { "method": "POST", "path": "/v1/documents", "does": "Upload a document to convert for a model" }
      ]
    },
